# ============================================================
# PlanZy — пример конфигурации окружения
# Скопируйте этот файл в .env и заполните реальными значениями
# ============================================================

# --- Telegram ---
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAaaBBccDDeeFFggHHiiJJkkLLmmNNooPP

# Telegram user_id владельца (тренера). Бот отвечает только этому пользователю.
# Узнать свой id можно у бота @userinfobot
OWNER_TELEGRAM_ID=123456789

# --- Gemini Flash ---
# API-ключ Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini для парсинга диктовки
GEMINI_MODEL=gemini-3.6-flash

# --- База данных ---
# SQLite с WAL-режимом. Путь относительно корня проекта.
DATABASE_URL=sqlite+aiosqlite:///./tutor.sqlite3

# --- Настройки тренера (значения по умолчанию) ---
# ВАЖНО: цена занятия, валюта и часовой пояс теперь хранятся в БД
# отдельно для каждого тренера и меняются в веб-кабинете
# (раздел «Настройки»). Переменные ниже используются только как
# запасные значения, если тренер ещё не задал свои настройки.
#
# Стоимость одного занятия. Если задана, бот сам считает, сколько занятий
# даёт названная сумма: «оплата 120» при цене 30 → +4 занятия.
# 0 отключает автоматический расчёт (тогда нужно называть число занятий).
LESSON_PRICE=0

# Валюта по умолчанию для платежей: ILS, USD, EUR, RUB
CURRENCY=ILS

# Часовой пояс тренера (IANA, например Asia/Jerusalem)
TIMEZONE=Asia/Jerusalem

# --- Веб ---
# Публичный базовый URL для генерации ссылок на смарт-карточки
BASE_URL=https://planzy.dvorzhik.site

# Хост и порт, на которых слушает FastAPI
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Планировщик ---
# Время утренней рассылки (ЧЧ:ММ) — напоминания о занятиях на сегодня
MORNING_DISPATCH_TIME=08:30

# Время вечерней рассылки (ЧЧ:ММ) — напоминания о занятиях на завтра
DAY_BEFORE_DISPATCH_TIME=19:00

# --- Логирование ---
LOG_LEVEL=INFO

# --- Режим работы ---
# development | production
APP_ENV=development
